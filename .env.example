# ============================================================
# Cloud-RT-IDS  ·  Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file must NOT be committed to version control.
# All variables have sensible defaults and are optional
# unless marked REQUIRED.
# ============================================================

# ── Backend server ──────────────────────────────────────────
IDS_HOST=0.0.0.0
IDS_PORT=5000
IDS_DEBUG=false

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
IDS_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# ── Security ────────────────────────────────────────────────
# Optional API key.  If set, all non-health endpoints require
# the header:  X-API-Key: <value>
# Leave empty to disable authentication (local dev only).
IDS_API_KEY=

# ── Prediction history ──────────────────────────────────────
# Maximum number of prediction records kept in memory / disk.
IDS_MAX_HISTORY=10000

# ── Logging ─────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
IDS_LOG_LEVEL=INFO

# ── (Future) Database ───────────────────────────────────────
# Uncomment when a relational DB is added.
# DATABASE_URL=postgresql://user:password@localhost:5432/ids

# ── (Future) Redis ──────────────────────────────────────────
# Uncomment when Redis Streams are added.
# REDIS_URL=redis://localhost:6379/0
